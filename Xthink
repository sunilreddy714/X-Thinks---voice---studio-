


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>X Thinks Voice Studio</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#090909;color:white;
 font-family:Arial,sans-serif;padding:22px;
}
header{text-align:center;margin:20px 0 30px}
.logo{font-size:43px;font-weight:900;color:white}
.logo span{color:#ed2525}
.tag{color:#999;font-size:12px;letter-spacing:2px}
.panel{
 max-width:550px;margin:auto;background:#151515;
 padding:22px;border:1px solid #333;border-radius:16px;
}
h2{font-size:19px}
label{display:block;margin:18px 0 8px;color:#bbb}
textarea,select{
 width:100%;background:#090909;color:white;
 border:1px solid #444;border-radius:9px;
 padding:13px;font-size:15px;
}
textarea{height:170px;resize:vertical}
input{width:100%;accent-color:#ed2525}
.buttons{display:flex;gap:9px;margin-top:22px}
button{
 flex:1;padding:13px;border:0;border-radius:8px;
 background:#ed2525;color:white;font-weight:bold;
}
button.secondary{background:#292929}
.status{text-align:center;color:#aaa;font-size:12px;margin-top:18px}
footer{text-align:center;color:#666;font-size:11px;margin:25px}
</style>
</head>
<body>
<header>
 <div class="logo"><span>X</span> THINKS</div>
 <div class="tag">THINK DIFFERENTLY. EXPLORE BEYOND.</div>
</header>

<div class="panel">
 <h2>AI VOICE STUDIO</h2>

 <label>Enter Your Telugu Script</label>
 <textarea id="script" placeholder="మీ కథను ఇక్కడ రాయండి..."></textarea>

 <label>Voice Language</label>
 <select id="language">
  <option value="te-IN">Telugu</option>
  <option value="kn-IN">Kannada</option>
  <option value="hi-IN">Hindi</option>
  <option value="en-IN">English India</option>
 </select>

 <label>Voice Style</label>
 <select id="style">
  <option value="normal">Cinematic Natural</option>
  <option value="slow">Suspense Thriller</option>
  <option value="dramatic">Dramatic Narration</option>
 </select>

 <label>Speed: <span id="speedValue">0.85</span></label>
 <input id="speed" type="range" min="0.6" max="1.3"
 step="0.05" value="0.85">

 <label>Pitch: <span id="pitchValue">0.8</span></label>
 <input id="pitch" type="range" min="0.6" max="1.3"
 step="0.05" value="0.8">

 <div class="buttons">
  <button onclick="speak()">GENERATE / PLAY</button>
  <button class="secondary" onclick="pauseVoice()">PAUSE</button>
  <button class="secondary" onclick="stopVoice()">STOP</button>
 </div>

 <div class="status" id="status">X THINKS VOICE SYSTEM READY</div>
</div>
<footer> X THINKS © 2026 </footer>

<script>
const $ = id => document.getElementById(id);
let voices = [];

function loadVoices(){
 voices = speechSynthesis.getVoices();
}
loadVoices();
speechSynthesis.onvoiceschanged = loadVoices;

$("speed").oninput = () =>
 $("speedValue").textContent = $("speed").value;
$("pitch").oninput = () =>
 $("pitchValue").textContent = $("pitch").value;

function speak(){
 const text = $("script").value.trim();
 if(!text){$("status").textContent="Please enter your script";return;}

 speechSynthesis.cancel();

 const utterance = new SpeechSynthesisUtterance(text);
 const lang = $("language").value;
 utterance.lang = lang;
 utterance.rate = Number($("speed").value);
 utterance.pitch = Number($("pitch").value);

 const matching = voices.filter(v =>
  v.lang.toLowerCase().startsWith(lang.slice(0,2).toLowerCase())
 );
 if(matching.length) utterance.voice = matching[0];

 if($("style").value === "slow") utterance.rate *= 0.85;
 if($("style").value === "dramatic") utterance.rate *= 0.95;

 utterance.onstart = () => $("status").textContent="PLAYING...";
 utterance.onend = () => $("status").textContent="VOICE COMPLETED";
 utterance.onerror = () => $("status").textContent="Voice unavailable on this device";

 speechSynthesis.speak(utterance);
}
function pauseVoice(){
 speechSynthesis.pause();
 $("status").textContent="PAUSED";
}
function stopVoice(){
 speechSynthesis.cancel();
 $("status").textContent="STOPPED";
}
</script>
</body>
</html>
